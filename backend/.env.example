# ===========================================================================
# backend/.env.example  —  copy to backend/.env and fill in real values
# ---------------------------------------------------------------------------
#   cd backend
#   cp .env.example .env
#
# The backend reads these via pydantic-settings (see app/config.py).
# Every value here has a safe default EXCEPT the provider API keys, which are
# only needed when you enable that provider in ENABLED_PROVIDERS.
# ===========================================================================

# --- Core app --------------------------------------------------------------
APP_ENV=development

# Front-end origins allowed to call this API (CORS). Comma-separated.
# Add your deployed frontend URL here in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------
# Local default is a SQLite file. On Railway, add a Postgres plugin and set
# this to the connection URL it provides (postgresql://...).
DATABASE_URL=sqlite:///./app/data/local.sqlite3

# --- Providers ---------------------------------------------------------
# Comma-separated, in priority order. Start with just "mock".
# Add real providers once you have their keys: mock,duffel,amadeus
ENABLED_PROVIDERS=mock

# Duffel — https://duffel.com  (sandbox token looks like: duffel_test_xxx)
DUFFEL_API_TOKEN=
DUFFEL_API_VERSION=v2

# Amadeus for Developers — https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# Kiwi.com Tequila — https://tequila.kiwi.com
TEQUILA_API_KEY=

# Travelpayouts / Skyscanner affiliate — https://travelpayouts.com
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Currency conversion --------------------------------------------
CURRENCY_PROVIDER=er_api
EXCHANGERATE_HOST_ACCESS_KEY=

# --- Price-drop alerts (optional) ----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@flight-scheduler.local
ALERTS_CRON_SECRET=
