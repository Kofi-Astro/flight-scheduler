# ===========================================================================
# frontend/.env.example  —  copy to frontend/.env for local dev
#   cd frontend
#   cp .env.example .env
#   python server.py
# ===========================================================================

# Public URL of the backend API the browser should call.
# Local dev: the backend runs on :8000
API_BASE_URL=http://localhost:8000

# Port the static server listens on. Railway injects PORT automatically in
# production, so you only set this locally.
PORT=5173
