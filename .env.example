# ===========================================================================
# Flight Scheduler — Example environment file  (ROOT / quick reference)
# ===========================================================================
# This root file is a COMBINED reference showing every variable the project
# understands. In practice each deployable service reads its own file:
#
#   backend/.env    <-- copy from backend/.env.example
#   frontend/.env   <-- copy from frontend/.env.example
#
# Copy the relevant section into those files and fill in real values.
# NEVER commit a filled-in .env — only these *.example files are tracked.
# ===========================================================================


# ---------------------------------------------------------------------------
# BACKEND (FastAPI)  ->  backend/.env
# ---------------------------------------------------------------------------

# --- Core app ---
# Comma-separated list of front-end origins allowed to call the API (CORS).
# During local dev the static server runs on :5173; add your Railway domain
# for production, e.g. "https://flights.example.com".
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environment name — "development" enables verbose errors + auto-reload docs.
APP_ENV=development

# --- Database ---
# SQLAlchemy URL. Defaults to a local SQLite file if omitted.
# For Railway Postgres, set this to the "Postgres Connection URL" Railway gives
# you (starts with postgresql://). SQLAlchemy + our code handle both.
DATABASE_URL=sqlite:///./app/data/local.sqlite3

# --- Flight data providers ---
# Which providers to query, in priority order. Comma-separated.
# Options: mock, duffel, amadeus, kiwi, travelpayouts
# "mock" returns realistic synthetic data so the app works with no keys.
ENABLED_PROVIDERS=mock

# Duffel  (https://duffel.com — self-serve signup, free test mode)
# Use a token starting with "duffel_test_" for the sandbox.
DUFFEL_API_TOKEN=
DUFFEL_API_VERSION=v2

# Amadeus Self-Service (https://developers.amadeus.com — free test tier)
# The test environment uses host test.api.amadeus.com; production uses api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# Kiwi.com Tequila API (https://tequila.kiwi.com — approval needed for production)
TEQUILA_API_KEY=

# Travelpayouts / Skyscanner affiliate (https://travelpayouts.com)
# Used for affiliate deep links + (optionally) the Flight Data API.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Currency conversion ---
# Free FX source. open.er-api.com needs no key. exchangerate.host "access_key"
# is optional and only used if you switch CURRENCY_PROVIDER to exchangerate_host.
CURRENCY_PROVIDER=er_api
EXCHANGERATE_HOST_ACCESS_KEY=

# --- Price-drop alerts (nice-to-have) ---
# SMTP for email alerts. Leave blank to disable email sending (alerts still
# get stored and can be checked via the API / a cron job).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@flight-scheduler.local

# Optional: a shared secret required to trigger the alert-check endpoint
# (so you can safely call it from a Railway cron without exposing it).
ALERTS_CRON_SECRET=


# ---------------------------------------------------------------------------
# FRONTEND (static site)  ->  frontend/.env
# ---------------------------------------------------------------------------

# Public URL of the backend API. The static server injects this into the page
# at runtime as window.__CONFIG__.API_BASE_URL (see frontend/server.py).
# Local dev default:
API_BASE_URL=http://localhost:8000

# Port the static server listens on (Railway sets PORT automatically).
PORT=5173
